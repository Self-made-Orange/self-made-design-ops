  "z_index": {
    "source": "patterns/navigation.md, systems/{chakra-ui,bootstrap,open-props,forma-36,vibes}.md",
    "$comment": "토큰화 7개 시스템이 7가지 산법. 건너뛰기 링크 전용 층위 1600은 Chakra·Pluralsight 2건이 같은 값. 층위 순서는 시스템 간 모순 — 교차 권고값 없음",
    "schemes": {
      "Chakra": {
        "method": "용도명 + 100 등차",
        "range": "hide:-1 ~ tooltip:1800 + max:int32"
      },
      "Bootstrap": {
        "method": "1000대 + 배경/본체 +5",
        "range": "dropdown:1000 ~ tooltip:1080"
      },
      "Open Props": {
        "method": "서수",
        "range": "layer-1~5 + important:int32"
      },
      "Forma 36": {
        "method": "10의 거듭제곱",
        "range": "-1,1,10,100,1000,10000"
      },
      "Vibes": {
        "method": "불규칙 점프",
        "range": "100,200,500,1000,1500,2000,3000,4000 + max:int32"
      },
      "Solid (BuzzFeed)": {
        "method": "100 등차 서수",
        "range": "z1:100 ~ z4:400"
      },
      "Pluralsight": {
        "method": "영역 이름 + 10 단위 미세 배치 (`layers`)",
        "range": "main:0 · sidenav:930 · topnav:950 · dropdown:1000 · skip-to-content:1600"
      }
    }
  },
